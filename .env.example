# The Gemini API key and Gemma models are set on the Settings page, not here.
# 32+ random bytes, base64: openssl rand -base64 32
APP_SECRET=
# Local dev: docker compose up -d db. In docker compose the app overrides this to reach the db service.
DATABASE_URL=postgres://codeku:codeku@127.0.0.1:5433/codeku
PORT=8787
HOST=127.0.0.1

# E2E only (npm run e2e, server must already be running)
E2E_BASE_URL=http://localhost:8787
E2E_PROXMOX_URL=https://your-host.your-tailnet.ts.net
E2E_PROXMOX_TOKEN_ID=root@pam!sandbox
E2E_PROXMOX_TOKEN_SECRET=
# Optional, auto-detected from GET /nodes
E2E_PROXMOX_NODE=
E2E_TEMPLATE_VMID=9000
E2E_BRIDGE=vmbr0
E2E_ALLOW_SELF_SIGNED=false
E2E_SSH_PUBLIC_KEY=
E2E_GITHUB_TOKEN=
# A repo with a dev server (e.g. a Vite app); private repos need E2E_GITHUB_TOKEN
E2E_REPO_URL=https://github.com/OWNER/REPO
# Path inside the project that the dev server serves as-is, e.g. index.html
E2E_RELOAD_FILE=index.html
# Workspace RAM for the E2E VM; keep it under the host's free memory
E2E_MEMORY_MB=2048
