                        12
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "odYCz",
                          "name": "Line 1",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "You set up a GitHub project for development inside an Ubuntu 24.04 VM.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Wwssm",
                          "name": "Line 2",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The project is cloned at {projectPath}. Its owner is the user \"dev\". Commands run as root in that directory.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "D43Vvt",
                          "name": "Line 3",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Docker, Docker Compose, git, Node.js 22 and npm are installed. Install any other runtime the project needs yourself.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "OslJh",
                          "name": "Line 4",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": " ",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "I96UzP",
                          "name": "Line 5",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Goal: start every service of this project in dev/watch mode with hot reload, bound to 0.0.0.0.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Mp6dN",
                          "name": "Line 6",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Read the README, package files and compose files before deciding what to run.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "rwHSg",
                          "name": "Line 7",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Install dependencies as user dev (sudo -u dev ...), so files in the project stay owned by dev.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "diOFN",
                          "name": "Line 8",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Run each app process as a systemd unit named {projectName}-SERVICE.service with User=dev and Restart=always.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Q0cUQ",
                          "name": "Line 9",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Ports already used in this VM, never use them: {usedPorts}. Also check with ss -ltnp before choosing a port.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "M31wC",
                          "name": "Line 10",
                          "fill": "$p-attention",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Prefer pnpm when the repo has a pnpm-lock.yaml. Never run database migrations that drop data.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "aztRO",
                          "name": "Line 11",
                          "fill": "$p-fg",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "- Always finish by calling report_services with the services the user should open in a browser.",
                          "lineHeight": 1.5,
                          "fontFamily": "$p-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
